        "types": "./dist/stream.d.cts",
        "default": "./dist/stream.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine/index.js"
      },
      "require": {
        "types": "./dist/engine/index.d.cts",
        "default": "./dist/engine/index.cjs"
      }
    },
    "./vault": {
      "import": {
        "types": "./dist/vault/index.d.ts",
        "default": "./dist/vault/index.js"
      },
