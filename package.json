{
  "name": "anonyma",
  "version": "1.1.0",
  "author": "Izac Cavalheiro <izac@izaccavalheiro.com>",
  "description": "TypeScript-first PII detection & anonymization — 27 built-in detectors (email, SSN, IBAN, and more), 8 strategies (mask, redact, hash, AES-256 encrypt, tokenize, pseudonymize, generalize, synthesize), 8 compliance presets (GDPR, LGPD, PIPEDA, HIPAA, CCPA, PCI-DSS, SOX, FERPA), a span engine with chunk-safe streaming, reversible and keyed tokenization with key rotation, a zero-PII audit log, regulation profiles, LLM/AI helpers, an MCP server, HTTP middleware, batch processing, checksum validators, and optional Zod schemas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izaccavalheiro/anonyma.git"
  },
  "homepage": "https://github.com/izaccavalheiro/anonyma#readme",
  "bugs": {
    "url": "https://github.com/izaccavalheiro/anonyma/issues"
  },
  "keywords": [
    "anonymization",
    "pii",
    "pii-detection",
    "data-anonymization",
    "text-anonymization",
    "privacy",
    "data-privacy",
    "gdpr",
    "lgpd",
    "pipeda",
    "hipaa",
    "ccpa",
    "pci-dss",
    "sox",
    "ferpa",
    "compliance",
    "audit-log",
    "phi",
    "sensitive-data",
    "redaction",
    "masking",
    "pseudonymization",
    "tokenization",
    "encryption",
    "hashing",
    "data-sanitization",
    "typescript",
    "ai",
    "llm",
    "mcp",
    "middleware",
    "streaming",
    "web-crypto",
    "zero-dependencies"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.js"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    },
    "./detectors": {
      "import": {
        "types": "./dist/detectors/index.d.ts",
        "default": "./dist/detectors/index.js"
      },
      "require": {
        "types": "./dist/detectors/index.d.cts",
        "default": "./dist/detectors/index.cjs"
      }
    },
    "./validators": {
      "import": {
        "types": "./dist/validators.d.ts",
        "default": "./dist/validators.js"
      },
      "require": {
        "types": "./dist/validators.d.cts",
        "default": "./dist/validators.cjs"
      }
    },
    "./crypto": {
      "import": {
