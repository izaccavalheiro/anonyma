{
  "name": "anonyma-native",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js and Bun bindings of the Rust core of anonyma (napi-rs). Not published yet: see README.md.",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "anonyma-native",
    "triples": {
      "defaults": true,
      "additional": ["aarch64-apple-darwin", "aarch64-unknown-linux-gnu"]
    }
  },
  "scripts": {
    "build": "napi build --platform --release"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "engines": {
    "node": ">=18"
  }
}
