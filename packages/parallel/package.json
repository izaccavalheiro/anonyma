{
  "name": "anonyma-parallel",
  "version": "0.1.0",
  "description": "Run anonyma's batch functions on every core: a pool of worker threads for Node.js, Bun and Deno that splits large batches, keeps their order and returns what anonyma returns.",
  "license": "MIT",
  "author": "Izac Cavalheiro <izac@izaccavalheiro.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izaccavalheiro/anonyma.git",
    "directory": "packages/parallel"
  },
  "homepage": "https://github.com/izaccavalheiro/anonyma/tree/main/packages/parallel#readme",
  "bugs": {
    "url": "https://github.com/izaccavalheiro/anonyma/issues"
  },
  "keywords": [
    "anonyma",
    "pii",
    "anonymization",
    "redaction",
    "worker-threads",
    "parallel",
    "batch",
    "privacy"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsup && vitest run",
    "check:package": "publint --strict && attw --pack . --profile node16"
  },
  "peerDependencies": {
    "anonyma": "^1.5.0"
  },
  "devDependencies": {
    "anonyma": "file:../.."
  },
  "engines": {
    "node": ">=18.3"
  }
}
