{
  "name": "anonyma-sidecar",
  "version": "0.2.0",
  "private": true,
  "description": "A local HTTP and MCP service that scrubs personal data for any language: detect, anonymize, shield prompts with vault tokens and restore answers, over localhost. Built on anonyma; shipped as a container image.",
  "license": "MIT",
  "author": "Izac Cavalheiro <izac@izaccavalheiro.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izaccavalheiro/anonyma.git",
    "directory": "packages/sidecar"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "anonyma-sidecar": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "proto",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "anonyma": "^1.5.0"
  },
  "devDependencies": {
    "anonyma": "file:../.."
  },
  "engines": {
    "node": ">=20"
  }
}
