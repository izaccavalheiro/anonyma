# Dependencies
node_modules/

# Build output
dist/

# Coverage reports
coverage/

# TypeScript incremental build info
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# npm/yarn/pnpm lock files (keep package-lock.json for reproducibility)
yarn.lock
pnpm-lock.yaml

# Temporary files
tmp/
temp/

# Tarballs of the companion packages (scripts/publish-packages.mjs)
dist-packages/

# Rust build output
target/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
bindings/python/dist/
bindings/python/python/anonyma/*.so
bindings/python/python/anonyma/*.pyd

# Native and WebAssembly bindings
bindings/node/*.node
bindings/node/index.js
bindings/node/index.d.ts
bindings/wasm/pkg/

# Static libraries of the Go package (go generate in bindings/go; prebuilt in releases)
bindings/go/lib/
