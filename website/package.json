{
  "name": "anonyma-website",
  "version": "0.0.0",
  "private": true,
  "description": "The anonyma site: getting started, documentation, the playground and benchmarks, published to GitHub Pages.",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "start": "npm run sync && docusaurus start",
    "build": "npm run sync && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "npm run sync && tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "anonyma": "file:..",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "~6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "serialize-javascript": "7.1.4",
    "uuid": "11.1.1"
  }
}
